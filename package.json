{
  "name": "ai-support-bot",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "build:hosting": "opennextjs-cloudflare build",
    "start": "next start",
    "preview:hosting": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "lint": "eslint",
    "knowledge:upsert": "tsx scripts/upsertKnowledge.ts",
    "knowledge:upsert:verified": "tsx scripts/upsertKnowledge.ts data/verifiedKnowledge.json",
    "knowledge:upsert:draft-extra": "tsx scripts/upsertKnowledge.ts data/knowledge.draft.extra-questions.json",
    "knowledge:compact": "tsx scripts/compactKnowledge.ts",
    "knowledge:replace:compact": "tsx scripts/replaceKnowledge.ts data/knowledge.compact.json --yes",
    "suppliers:import": "tsx scripts/importSuppliers.ts",
    "eval:retrieval": "tsx scripts/evaluateRetrieval.ts",
    "eval:real-world:build": "tsx scripts/buildRealWorldEval.ts",
    "eval:answers": "tsx scripts/evaluateAnswers.ts",
    "eval:clarification": "tsx scripts/evaluateClarification.ts",
    "eval:multi-turn:build": "tsx scripts/buildMultiTurnEval.ts",
    "eval:multi-turn": "tsx scripts/evaluateMultiTurn.ts",
    "knowledge:backlog": "tsx scripts/buildKnowledgeBacklog.ts",
    "reset-test-history": "tsx scripts/resetTestHistory.ts",
    "admin:grant": "tsx scripts/grantAdmin.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:security": "vitest run tests/adminAuthorization.test.ts tests/securityRouteCoverage.test.ts tests/visitorOwnership.test.ts tests/rateLimit.test.ts",
    "test:intents": "vitest run tests/residentIntent.test.ts",
    "typecheck": "tsc --noEmit",
    "security:gate": "tsx scripts/securityReleaseGate.ts",
    "check:env": "tsx scripts/checkEnvironment.ts --network",
    "check:env:ci": "tsx scripts/checkEnvironment.ts --ci",
    "smoke:documents": "tsx scripts/smokeDocumentIntelligence.ts",
    "check": "npm run check:env:ci && npm run lint && npm run typecheck && npm run test:run && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.109.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "3.2.7",
    "wrangler": "4.86.0"
  },
  "overrides": {
    "tsx": {
      "esbuild": "0.28.1"
    },
    "postcss": "8.5.24",
    "ws": "8.21.1"
  }
}
