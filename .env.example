# Supabase Configuration
# Get these from your Supabase project settings at https://app.supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
VISITOR_TOKEN_SECRET=replace-with-at-least-32-random-characters

# Public Supabase Configuration (available in browser)
# These are the same as above, used for client-side Supabase initialization
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# OpenAI Configuration
# Get your API key from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-proj-your-api-key-here
# Optional: model for admin PDF analysis and receipt OCR/vision (default gpt-4.1)
OPENAI_ANALYSIS_MODEL=gpt-4.1
# Optional: model for chat answers (default gpt-4.1)
OPENAI_CHAT_MODEL=gpt-4.1
# Optional: OCR/vision image detail for scans/photos (low | high | auto)
OPENAI_OCR_IMAGE_DETAIL=high

# Optional email notifications via Resend
RESEND_API_KEY=re_your-api-key-here
MAIL_FROM=Astana ERC <no-reply@example.com>

# Optional: Debug mode for retrieval logging
DEBUG_RETRIEVAL=false

# Optional: RAG rollout switch. Use "legacy" to temporarily return to the old retrieval path.
RAG_PIPELINE_VERSION=v2

# Optional: "true" lets unverified (draft) knowledge rows into chat answers.
# Keep "false" unless the knowledge base has no verified rows yet.
RAG_ALLOW_UNVERIFIED_CONTEXT=false

# Optional: Environment designation (development, staging, production)
NODE_ENV=development
